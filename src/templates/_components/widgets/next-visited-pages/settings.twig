{% import "_includes/forms" as forms %}

{% set widgetId = '#widget' ~ widget.id %}
<div id="{{ id }}">

    {% set rangeInput %}
        <div class="select">
            <select id="dateRange" name="dateRange">
                <option value="previousHour"{% if widget.dateRange=='previousHour' %} selected{% endif %}>{{ 'Previous hour'|t('counter') }}</option>
                <option value="todayPriorToThisHour"{% if widget.dateRange=='todayPriorToThisHour' %} selected{% endif %}>{{ 'Today (prior to this hour)'|t('counter') }}</option>
                <option value="yesterday"{% if widget.dateRange=='yesterday' %} selected{% endif %}>{{ 'Yesterday'|t('counter') }}</option>
            </select>
        </div>
    {% endset %}

    {{ forms.field({
        id: 'rangeInput',
        label: "Date Range"|t('counter')
    }, rangeInput) }}

    {{ forms.selectField({
        label: 'Page'|t('counter'),
        id: 'pageId',
        name: 'pageId',
        options: [],
        value: widget.pageId,
        errors: widget.getErrors('pageId'),
        required: true,
    }) }}

    {{ forms.textField({
        label: 'Next visits in seconds'|t('counter'),
        id: 'difference',
        name: 'difference',
        required: true,
        value: widget.difference is defined ? widget.difference,
    }) }}

    {{ forms.textField({
        label: 'Limit number of pages on chart'|t('counter'),
        id: 'nextPagesLimit',
        name: 'nextPagesLimit',
        required: false,
        tip: 'If not set, all pages will appear on the chart. the minimum value is 0.',
        value: widget.nextPagesLimit is defined ? widget.nextPagesLimit,
    }) }}

    {{ forms.lightswitchField({
        label: 'Load widget data after page load'|t('counter'),
        id: 'useAjax',
        name: 'useAjax',
        required: false,
        value: 1,
        on: widget.useAjax is defined ? widget.useAjax,
        tip: 'If loading this widget takes time, select this option to delay its loading until after the page has loaded.'|t('counter'),
    }) }}

    {#
    {{ forms.textField({
        label: 'Auto refresh the widget'|t('counter'),
        id: 'autoRefreshWidget',
        name: 'autoRefreshWidget',
        required: false,
        instruction: 'Specify interval raete in milliseconds'|t('counter'),
        tip: 'Auro refresh does not work for date ranges like yesterday, previous hour'|t('counter'),
        value: widget.autoRefreshWidget is defined ? widget.autoRefreshWidget,
    }) }}
    #}
    {#
    {% set typeInput %}
        <div class="select">
            <select id="type" name="type">
                <option value="percentage"{% if widget.type=='percentage' %} selected{% endif %}>{{ 'Percentage'|t('counter') }}</option>
                <option value="count"{% if widget.type=='count' %} selected{% endif %}>{{ 'Count'|t('counter') }}</option>
            </select>
        </div>
    {% endset %}

    {{ forms.field({
        id: 'type',
        label: "Type"|t('counter'),
    }, typeInput) }}
    #}

</div>

{% if selectedPage %}
    {% set options = [{'id': widget.pageId, 'name': selectedPage }] %}
{% else %}
    {% set options = [] %}
{% endif %}

{% css %}
    {{ widgetId }} div[data-attribute="autoRefreshWidget"] {
        display: none;
    }
    div[data-attribute=pageId] .select
    {
        min-width: 300px;
    }
    div[data-attribute=pageId] .selectize-input
    {
       overflow: hidden;
    }
{% endcss %}
{% js %}

    if ($('{{ widgetId }} div[data-attribute="useAjax"] input').val() == '1') {
        $('{{ widgetId }} div[data-attribute="autoRefreshWidget"]').css('display', 'block');
    }

    $('{{ widgetId }} div[data-attribute="useAjax"] .lightswitch').on('change', function() {
        var isEnabled = $(this).find('input').val();
        if (isEnabled) {
            $('{{ widgetId }} div[data-attribute="autoRefreshWidget"]').css('display', 'block');
        } else {
            $('{{ widgetId }} div[data-attribute="autoRefreshWidget"]').css('display', 'none');
        }
    });

    var csrfTokenName;
    var csrfTokenValue;
    $.ajax({
        url: '{{ sessionInfoUrl }}',
        type: 'GET',
        dataType: 'json',
        success: function(result) { 
            csrfTokenName = result.csrfTokenName;
            csrfTokenValue = result.csrfTokenValue;
        }
    });

    $('#{{ namespaceId }} div[data-attribute=items] select').selectize({
        plugins: ['remove_button'],
        dropdownParent: 'body',
    });

    $('#{{ namespaceId }} div[data-attribute=pageId] select').selectize({
        maxItems: 1,
        valueField: 'id',
        labelField: 'name',
        searchField: 'name',
        autocomplete: true,
        persist: false,
        plugins: ['remove_button'],
        dropdownParent: 'body',
        create: false,
        openOnFocus: false,
        options: {{ options|json_encode|raw }},
        items: ['{{ widget.pageId }}'],
        render: {
            option: function(item, escape) {
                return '<div>' + item.name + '</div>';
            }
        },
        load: function(query, callback) {
            if (!query.length) return callback();
            var data = {};
            data[csrfTokenName] = csrfTokenValue;
            data['search'] = query,
            $.ajax({
                url: '{{ pageListURL }}',
                type: 'POST',
                dataType: 'json',
                data: data,
                success: function(res) {
                    callback(res);
                }
            });
        }
    });
{% endjs %}