{% import "_includes/forms" as forms %}

{% set widgetId = '#widget' ~ widget.id %}
<div id="{{ id }}">
    {% if craft.app.getIsMultiSite() %}
        {% set allSites = craft.app.sites.getAllSites() %}
        {% set editableSites = craft.app.sites.getEditableSites() %}
            {% set siteInput %}
                <div class="select">
                    <select id="site-id" name="siteId">
                        {% if allSites|length == editableSites|length %}
                            <option value="*"{% if widget.siteId=='*' %} selected{% endif %}>{{ 'All'|t('site') }}</option>
                        {% endif %}
                        {% for site in editableSites %}
                            <option value="{{ site.id }}"{% if site.id == widget.siteId %} selected{% endif %}>{{ site.name|t('site') }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% endset %}

            {{ forms.field({
                id: 'site-id',
                label: "Site"|t('app')
            }, siteInput) }}
    {% endif %}

    {% set display = "none" %}
    {% if showAllCalendars %}
        {% set display = "block" %}
    {% endif %}

    {% include 'counter/_components/widgets/_includes/_calendarField' %}

    {% include 'counter/_components/widgets/_includes/_dateRangeField' with { id: namespaceId, widget: widget } %}

    {{ forms.lightswitchField({
        label: 'Show chart'|t('counter'),
        id: 'showChart',
        name: 'showChart',
        required: false,
        value: 1,
        on: widget.showChart is defined ? widget.showChart, 
    }) }}

    {{ forms.lightswitchField({
        label: 'Load widget data after page load'|t('counter'),
        id: 'useAjax',
        name: 'useAjax',
        required: false,
        value: 1,
        on: widget.useAjax is defined ? widget.useAjax,
        tip: 'If loading this widget takes time, select this option to delay its loading until after the page has loaded.'|t('counter'),
    }) }}

    {#
    {{ forms.textField({
        label: 'Auto refresh the widget'|t('counter'),
        id: 'autoRefreshWidget',
        name: 'autoRefreshWidget',
        required: false,
        instruction: 'Specify interval raete in milliseconds'|t('counter'),
        tip: 'Auro refresh does not work for date ranges like yesterday, previous hour'|t('counter'),
        value: widget.autoRefreshWidget is defined ? widget.autoRefreshWidget,
    }) }}
    #}
</div>

{% css %}
    {{ widgetId }} div[data-attribute="autoRefreshWidget"] {
        display: none;
    }
{% endcss %}

{% js %}
    if ($('{{ widgetId }} div[data-attribute="useAjax"] input').val() == '1') {
        $('{{ widgetId }} div[data-attribute="autoRefreshWidget"]').css('display', 'block');
    }

    $('{{ widgetId }} div[data-attribute="useAjax"] .lightswitch').on('change', function() {
        var isEnabled = $(this).find('input').val();
        if (isEnabled) {
            $('{{ widgetId }} div[data-attribute="autoRefreshWidget"]').css('display', 'block');
        } else {
            $('{{ widgetId }} div[data-attribute="autoRefreshWidget"]').css('display', 'none');
        }
    });
{% endjs %}
{#
    // JS and CSS For on fly widget creation
#}
{% do view.registerAssetBundle("vnali\\counter\\assets\\CounterWidgetSettingsAsset") %}