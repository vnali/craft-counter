{% import "_includes/forms" as forms %}

{% set widgetId = '#widget' ~ widget.id %}
<div id="{{ id }}">
    {{ forms.selectField({
        label: 'Page'|t('counter'),
        id: 'pageId',
        name: 'pageId',
        options: [],
        value: widget.pageId,
        errors: widget.getErrors('pageId'),
        required: true,
    }) }}

    {{ forms.multiSelectField({
        label: 'Items'|t('counter'),
        id: 'items',
        name: 'items',
        options: items,
        values: widget.items,
        errors: widget.getErrors('items'),
        required: true,
    }) }}

    {{ forms.lightswitchField({
        label: 'Load widget data after page load'|t('counter'),
        id: 'useAjax',
        name: 'useAjax',
        required: false,
        value: 1,
        on: widget.useAjax is defined ? widget.useAjax,
        tip: 'If loading this widget takes time, select this option to delay its loading until after the page has loaded.'|t('counter'),
    }) }}

    {#
    {{ forms.textField({
        label: 'Auto refresh the widget'|t('counter'),
        id: 'autoRefreshWidget',
        name: 'autoRefreshWidget',
        required: false,
        instruction: 'Specify interval raete in milliseconds'|t('counter'),
        tip: 'Auro refresh does not work for date ranges like yesterday, previous hour'|t('counter'),
        value: widget.autoRefreshWidget is defined ? widget.autoRefreshWidget,
    }) }}
    #}
</div>

{% if selectedPage %}
    {% set options = [{'id': widget.pageId, 'name': selectedPage }] %}
{% else %}
    {% set options = [] %}
{% endif %}

{% css %}
    div[data-attribute=pageId] .select
    {
        min-width: 300px;
    }
    div[data-attribute=pageId] .selectize-input
    {
       overflow: hidden;
    }
{% endcss %}
{% js %}

    var csrfTokenName;
    var csrfTokenValue;
    $.ajax({
        url: '{{ sessionInfoUrl }}',
        type: 'GET',
        dataType: 'json',
        success: function(result) { 
            csrfTokenName = result.csrfTokenName;
            csrfTokenValue = result.csrfTokenValue;
        }
    });

    $('#{{ namespaceId }} div[data-attribute=items] select').selectize({
        plugins: ['remove_button'],
        dropdownParent: 'body',
    });

    $('#{{ namespaceId }} div[data-attribute=pageId] select').selectize({
        maxItems: 1,
        valueField: 'id',
        labelField: 'name',
        searchField: 'name',
        autocomplete: true,
        persist: false,
        plugins: ['remove_button'],
        dropdownParent: 'body',
        create: false,
        openOnFocus: false,
        options: {{ options|json_encode|raw }},
        items: ['{{ widget.pageId }}'],
        render: {
            option: function(item, escape) {
                return '<div>' + item.name + '</div>';
            }
        },
        load: function(query, callback) {
            if (!query.length) {
                return callback();
            }
            var data = {};
            data[csrfTokenName] = csrfTokenValue;
            data['search'] = query,
            $.ajax({
                url: '{{ pageListURL }}',
                type: 'POST',
                dataType: 'json',
                data: data,
                success: function(res) {
                    callback(res);
                }
            });
        }
    });

    if ($('{{ widgetId }} div[data-attribute="useAjax"] input').val() == '1') {
        $('{{ widgetId }} div[data-attribute="autoRefreshWidget"]').css('display', 'block');
    }

    $('{{ widgetId }} div[data-attribute="useAjax"] .lightswitch').on('change', function() {
        var isEnabled = $(this).find('input').val();
        if (isEnabled) {
            $('{{ widgetId }} div[data-attribute="autoRefreshWidget"]').css('display', 'block');
        } else {
            $('{{ widgetId }} div[data-attribute="autoRefreshWidget"]').css('display', 'none');
        }
    });
{% endjs %}

{% css %}
    {{ widgetId }} div[data-attribute="autoRefreshWidget"] {
        display: none;
    }
{% endcss %}

