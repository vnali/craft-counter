<div class="counter-widget-stat counter-widget-table-wrapper">
    <div id="{{ id }}"></div>
</div>
{% set tableData = [] %}

{% for topPage in topPages %}
    {% set title = craft.counter.removeDomainFromResult(topPage.page) %}
    {% if widgetTitleTruncateLength is integer and widgetTitleTruncateLength != 0 %}
        {% set title = title|truncate(widgetTitleTruncateLength, '...') %}
    {% endif %}
    {% set tableData = tableData|merge([{
        title: title,
        url: topPage.url,
        visits: topPage.visits,
    }]) %}
{% endfor %}

{% js %}
var columns = [
    { name: '__slot:title', title: Craft.escapeHtml(Craft.t('counter', 'Page')) },
    { name: 'visits', title: Craft.escapeHtml(Craft.t('counter', 'Visits')) },
];

new Craft.VueAdminTable({
    columns: columns,
    container: '#{{ id }}',
    tableData: {{ tableData|json_encode|raw }}
});
{% endjs %}