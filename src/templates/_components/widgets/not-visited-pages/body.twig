<div class="counter-widget-stat counter-widget-table-wrapper">
	<div id="{{ id }}"></div>
</div>
{% set tableData = [] %}

{% for notVisitedPage in notVisitedPages %}
	{% set title = notVisitedPage.page %}
	{% if removeDomainFromResult %}
		{% set title = craft.counter.removeDomainFromResult(title) %}
	{% endif %}
	{% if widgetTitleTruncateLength is integer and widgetTitleTruncateLength != 0 %}
		{% set title = title|truncate(widgetTitleTruncateLength, '...') %}
	{% endif %}
	{% set tableData = tableData|merge([{
        title: title,
        url: notVisitedPage.url,
        lastVisit: notVisitedPage.lastVisit,
    }]) %}
{% endfor %}

{% js %}
var columns = [
    { name: '__slot:title', title: Craft.escapeHtml(Craft.t('counter', 'Page')) },
    { name: 'lastVisit', title: Craft.escapeHtml(Craft.t('counter', 'Last Visit')) },
];

new Craft.VueAdminTable({
    columns: columns,
    container: '#{{ id }}',
    tableData:
{{ tableData|json_encode|raw }}
});
{% endjs %}
