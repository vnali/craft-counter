{% import "_includes/forms" as forms %}

{% set widgetId = '#widget' ~ widget.id %}
<div id="{{ id }}">
    {% if craft.app.getIsMultiSite() %}
    {% set allSites = craft.app.sites.getAllSites() %}
    {% set editableSites = craft.app.sites.getEditableSites() %}
        {% set siteInput %}
            <div class="select">
                <select id="site-id" name="siteId">
                    {% if allSites|length == editableSites|length %}
                        <option value="*"{% if widget.siteId=='*' %} selected{% endif %}>{{ 'All'|t('site') }}</option>
                    {% endif %}
                    {% for site in editableSites %}
                        <option value="{{ site.id }}"{% if site.id == widget.siteId %} selected{% endif %}>{{ site.name|t('site') }}</option>
                    {% endfor %}
                </select>
            </div>
        {% endset %}

        {{ forms.field({
            id: 'site-id',
            label: "Site"|t('app')
        }, siteInput) }}
    {% endif %}

    {% set rangeInput %}
        <div class="select">
            <select id="dateRange" name="dateRange">
                <option value="today"{% if widget.dateRange=='today' %} selected{% endif %}>{{ 'Today'|t('counter') }}</option>
                <option value="past2Days"{% if widget.dateRange=='past2Days' %} selected{% endif %}>{{ 'Past 2 days'|t('counter') }}</option>
                <option value="past7Days"{% if widget.dateRange=='past7Days' %} selected{% endif %}>{{ 'Past 7 days'|t('counter') }}</option>
                <option value="past30Days"{% if widget.dateRange=='past30Days' %} selected{% endif %}>{{ 'Past 30 days'|t('counter') }}</option>
                <option value="past90Days"{% if widget.dateRange=='past90Days' %} selected{% endif %}>{{ 'Past 90 days'|t('counter') }}</option>
            </select>
        </div>
    {% endset %}

    {{ forms.field({
        id: 'rangeInput',
        label: "Date Range"|t('counter'),
        tip: 'Results include pages not accessed within this range but viewed earlier.'|t('counter'),
    }, rangeInput) }}

    {{ forms.multiSelectField({
        label: 'Items'|t('counter'),
        id: 'items',
        name: 'items',
        options: items ?? [],
        values: widget.items ?? null,
    }) }}

    {{ forms.multiSelectField({
        label: 'Sections'|t('counter'),
        id: 'sectionHandles',
        name: 'sectionHandles',
        options: sections ?? [],
        values: widget.sectionHandles ?? null,
    }) }}

    {{ forms.lightswitchField({
        id: 'showElementTitle',
        name: 'showElementTitle',
        label: "Show element's title"|t('counter'),
        value: 1,
        on: widget.showElementTitle
    }) }}

    {{ forms.textField({
        label: 'Limit'|t('counter'),
        id: 'limit',
        name: 'limit',
        required: true,
        value: widget.limit,
    }) }}

    {{ forms.lightswitchField({
        label: 'Sort by Last Visit: Oldest First'|t('counter'),
        id: 'sortAsc',
        name: 'sortAsc',
        required: false,
        value: 1,
        on: widget.sortAsc is defined ? widget.sortAsc,
    }) }}

    {{ forms.lightswitchField({
        label: 'Load widget data after page load'|t('counter'),
        id: 'useAjax',
        name: 'useAjax',
        required: false,
        value: 1,
        on: widget.useAjax is defined ? widget.useAjax,
        tip: 'If loading this widget takes time, select this option to delay its loading until after the page has loaded.'|t('counter'),
    }) }}

    {#
    {{ forms.textField({
        label: 'Auto refresh the widget'|t('counter'),
        id: 'autoRefreshWidget',
        name: 'autoRefreshWidget',
        required: false,
        instruction: 'Specify interval raete in milliseconds'|t('counter'),
        tip: 'Auro refresh does not work for date ranges like yesterday, previous hour'|t('counter'),
        value: widget.autoRefreshWidget is defined ? widget.autoRefreshWidget,
    }) }}
    #}

    {% set display = "none" %}
    {% if showAllCalendars %}
        {% set display = "block" %}
    {% endif %}
    {% include 'counter/_components/widgets/_includes/_calendarField' %}
</div>

{% css %}
    {{ widgetId }} div[data-attribute="autoRefreshWidget"] {
        display: none;
    }
{% endcss %}

{% js %}
    $('#{{ namespaceId }} div[data-attribute=sectionHandles] select').selectize({
        plugins: ['remove_button'],
        dropdownParent: 'body',
    });

    $('#{{ namespaceId }} div[data-attribute=items] select').selectize({
        plugins: ['remove_button'],
        dropdownParent: 'body',
    });
{% endjs %}

